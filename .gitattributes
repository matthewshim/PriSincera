# 라인 엔딩 정규화 — Windows 데스크톱 ↔ macOS 노트북 병행 작업 전제.
# 없으면 두 머신의 core.autocrlf 설정이 우연히 맞아떨어져야만 정상 동작한다.

# 저장소 저장 형식은 항상 LF. 워킹트리는 플랫폼 관례를 따른다.
* text=auto

# 훅·셸 스크립트는 워킹트리에서도 반드시 LF.
# CRLF가 되면 shebang이 `#!/usr/bin/env node\r`로 해석되어
# `env: 'node\r': No such file or directory`로 훅이 죽고, 그 실패는 조용하다.
.githooks/** text eol=lf
*.sh        text eol=lf

# 바이너리 — 변환 금지
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.woff binary
*.woff2 binary
